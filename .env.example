# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Encryption (32-byte hex string for AES-256-GCM)
JWT_SECRET=super_secret_jwt_facebook_automation_jwt_key_2026
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (Leave empty to use automatic embedded in-memory MongoDB)
MONGODB_URI=mongodb://localhost:27017/facebook_live_automation

# Facebook Meta OAuth & Graph API
FACEBOOK_APP_ID=mock_fb_app_id_12345678
FACEBOOK_APP_SECRET=mock_fb_app_secret_87654321
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/facebook/callback
META_GRAPH_API_VERSION=v21.0
FACEBOOK_API_VERSION=v21.0

# Mock & Development Mode (Set true only for development mock tests; false in production)
FACEBOOK_MOCK_MODE=false
SCHEDULER_TEST_MODE=false

# Production & Scheduler Rotation Defaults
# Facebook live maximum duration is 8 hours. Default safety limit is 4h 50m (17400s)
DEFAULT_ROTATION_DURATION=17400
DEFAULT_RESTART_DELAY=60

# Test Mode Specifics (When SCHEDULER_TEST_MODE=true)
TEST_ROTATION_DURATION=15
TEST_RESTART_DELAY=3

# Scheduler Tick Interval (ms)
SCHEDULER_TICK_INTERVAL_MS=1000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
