{
  "name": "facebook-live-automation",
  "version": "1.3.0",
  "description": "Desktop Application for Scheduled Facebook Live Broadcast Automation with Seamless Looping & Multi-Hour Auto-Rotation",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "electron:dev": "concurrently -k \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"wait-on tcp:5173 && wait-on tcp:5000 && electron .\"",
    "electron:pack": "npm run build:frontend && electron-builder --dir",
    "electron:build": "npm run build:frontend && electron-builder",
    "electron:build:normal": "node scripts/build-normal-executable.js",
    "electron:build:trial": "node scripts/build-trial-executable.js",
    "electron:build:all": "node scripts/build-both-executables.js"
  },
  "build": {
    "appId": "com.facebook.liveautomation",
    "productName": "Facebook Live Streamer",
    "copyright": "Copyright © 2026 Facebook Live Automation",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "camera-agent/**/*",
      "!backend/bin/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Facebook Live Streamer",
      "artifactName": "${productName} Setup.${ext}"
    },
    "asarUnpack": [
      "**/node_modules/mongodb-memory-server/**/*"
    ]
  },
  "keywords": [
    "facebook",
    "live",
    "automation",
    "electron",
    "desktop",
    "streaming",
    "ffmpeg"
  ],
  "author": "Facebook Live Automation",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  }
}